# Frontend runtime mode expected by src/utils/api.ts
NODE_ENV=development

# local | staging | production
REACT_APP_ENVIRONMENT=local

# BFF base URL used in production-like calls and Vite proxy target fallback
REACT_APP_BFF_URL=http://localhost:3000

# Staging BFF base URL used when REACT_APP_ENVIRONMENT=staging
REACT_APP_BFF_URL_STAGING=https://grillrentbffv2-staging.up.railway.app

# Browser console verbosity: none | error | warn | info | debug
VITE_CONSOLE_LEVEL=warn

# Temporary login bootstrap fallback for cookie transport instability:
# when true, retries /users/profile once with Authorization bearer token after login.
REACT_APP_AUTH_PROFILE_BEARER_FALLBACK=false
